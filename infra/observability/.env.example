# 실제 값은 서버의 infra/observability/.env 또는 Secret 주입 경로에만 둔다.
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=
MATTERMOST_WEBHOOK_URL=
DOCKER_SOCKET_PATH=/var/run/docker.sock
GRAFANA_LOOPBACK_PORT=3000
# 아래 값은 BASELINE.md 측정·승인 후 입력한다. 예시 수치를 운영값으로 복사하지 않는다.
LOKI_RETENTION_PERIOD=
PROMETHEUS_RETENTION_TIME=
PROMETHEUS_RETENTION_SIZE=
ALLOY_CPU_LIMIT=
ALLOY_MEMORY_LIMIT=
ALLOY_CADVISOR_CPU_LIMIT=
ALLOY_CADVISOR_MEMORY_LIMIT=
LOKI_CPU_LIMIT=
LOKI_MEMORY_LIMIT=
PROMETHEUS_CPU_LIMIT=
PROMETHEUS_MEMORY_LIMIT=
GRAFANA_CPU_LIMIT=
GRAFANA_MEMORY_LIMIT=
