DEMO_VERIFY_WEB_COMMAND=curl --fail --silent --show-error --max-time 15 https://demo.ssafesta.world/ --output /dev/null
DEMO_VERIFY_LOGIN_COMMAND=curl --fail --silent --show-error --max-time 15 --request POST https://api.ssafesta.world/api/v1/auth/guest | grep --quiet '"accessToken"'
DEMO_VERIFY_WORLD_COMMAND=curl --fail --silent --show-error --max-time 15 https://demo.ssafesta.world/unity/manifest.json | grep --quiet '"loaderUrl"'
DEMO_VERIFY_AI_COMMAND=docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' festa-demo-ai-1 | grep --quiet '^healthy$'
DEMO_PROMOTION_STATE_DIR=/var/lib/festa-environments/demo
TEAM_DOMAIN=
TLS_CERT_PATH=
TLS_PRIVATE_KEY_PATH=
DOCKER_SOCKET_PATH=
UNITY_EDITOR_ROOT=
UNITY_LICENSE_OWNER=
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=
MATTERMOST_WEBHOOK_URL=
GAME_IMAGE_REF=
ROOT_DOMAIN=
DEMO_GAME_HOST_PORT=17777
# Demo World public host (Batch 1): demo.<root> 의 루트 WebSocket Upgrade 가 17777 로 간다. Production 은 world.<root>, dev 는 world-dev.<root>.
DEMO_WORLD_HOST=demo.${ROOT_DOMAIN}
CONNECTION_TOKEN_SECRET=
CONNECTION_TOKEN_SECRET_FILE=
WEBGL_RELEASE_ROOT=/srv/festa/webgl
WEBGL_PUBLIC_BASE_URL=https://demo.ssafesta.world/unity
WEBGL_RETENTION_COUNT=5
WORLD_REPLAY_LEDGER_VOLUME=
