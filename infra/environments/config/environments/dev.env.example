# dev에는 로컬에서 안전한 식별자와 Secret 파일 경로만 둔다.
FESTA_ENVIRONMENT=dev
COMPOSE_PROJECT_NAME=festa-dev
# Optional comma-separated mock adapter selection for a component deployment.
# Empty means that the component uses no mock adapter.
DEV_MOCK_COMPONENTS=
POSTGRES_ADMIN_CREDENTIAL_REF=local-dev-postgres-admin
POSTGRES_DEV_BACK_CREDENTIAL_REF=local-dev-postgres-back
POSTGRES_DEV_AI_CREDENTIAL_REF=local-dev-postgres-ai
POSTGRES_DEMO_BACK_CREDENTIAL_REF=local-demo-postgres-back
POSTGRES_DEMO_AI_CREDENTIAL_REF=local-demo-postgres-ai
REDIS_ADMIN_CREDENTIAL_REF=local-dev-redis-admin
POSTGRES_ADMIN_PASSWORD_FILE=./secrets/dev-postgres-admin-password
POSTGRES_DEV_BACK_PASSWORD_FILE=./secrets/dev-postgres-back-password
POSTGRES_DEV_AI_PASSWORD_FILE=./secrets/dev-postgres-ai-password
POSTGRES_DEMO_BACK_PASSWORD_FILE=./secrets/local-demo-postgres-back-password
POSTGRES_DEMO_AI_PASSWORD_FILE=./secrets/local-demo-postgres-ai-password
REDIS_ACL_FILE=./secrets/dev-users.acl
REDIS_HEALTH_PASSWORD_FILE=./secrets/dev-redis-health-password
REDIS_HEALTH_USER=health
DEV_BACK_CPU_LIMIT=1.0
DEV_BACK_MEMORY_LIMIT=1g
DEV_AI_CPU_LIMIT=1.0
DEV_AI_MEMORY_LIMIT=1g
DEV_FRONT_CPU_LIMIT=0.75
DEV_FRONT_MEMORY_LIMIT=512m
DEV_GAME_CPU_LIMIT=1.5
DEV_GAME_MEMORY_LIMIT=2g
ROOT_DOMAIN=example.test
PUBLIC_API_BASE_URL=
PUBLIC_AI_API_BASE_URL=
PUBLIC_AUTH_BASE_URL=https://api.example.test
PUBLIC_UNITY_BUILD_BASE=/unity/
CONNECTION_TOKEN_SECRET_FILE=./secrets/dev-game-connection-token
