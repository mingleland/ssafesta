server {
    listen 80;
    server_name ${PRODUCTION_WORLD_HOST};
    # 직결 호스트는 Let's Encrypt webroot 로 갱신한다 — Cloudflare 뒤의 world.<root> 에는 요청이 오지 않아 무해하다 (T-295).
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}
server {
    listen 443 ssl;
    server_name ${PRODUCTION_WORLD_HOST};
    ssl_certificate ${PRODUCTION_WORLD_CERTIFICATE_FILE};
    ssl_certificate_key ${PRODUCTION_WORLD_PRIVATE_KEY_FILE};
    location / {
        proxy_pass http://127.0.0.1:27777;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
        proxy_buffering off;
    }
}
