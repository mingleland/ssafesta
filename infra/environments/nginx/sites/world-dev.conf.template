map $http_upgrade $festa_dev_connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 80;
    server_name world-dev.${ROOT_DOMAIN};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name world-dev.${ROOT_DOMAIN};

    ssl_certificate ${NGINX_ORIGIN_CERTIFICATE_FILE};
    ssl_certificate_key ${NGINX_ORIGIN_PRIVATE_KEY_FILE};

    location / {
        include /etc/nginx/festa/dev-allowlist/*.conf;
        deny all;
        proxy_pass http://127.0.0.1:7777;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $festa_dev_connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_cache off;
        add_header Cache-Control "no-store" always;
    }
}
