# Demo World 는 demo.<root> 를 재사용한다 (Batch 1). Unity 클라이언트(UnityTransport WebSocket)는 host:port 만 받고
# 항상 루트 경로로 Upgrade 하므로, 루트 경로의 WebSocket Upgrade 만 17777 로 보내고 일반 HTTPS 는 Front 로 보낸다.
# world.<root> 는 Production World(27777) 전용이며 여기서 선언하지 않는다.
map $http_upgrade $festa_demo_root_upstream {
    default   http://127.0.0.1:18080;
    websocket http://127.0.0.1:17777;
}

map $http_upgrade $festa_demo_connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 80;
    server_name demo.${ROOT_DOMAIN};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name demo.${ROOT_DOMAIN};

    ssl_certificate ${NGINX_ORIGIN_CERTIFICATE_FILE};
    ssl_certificate_key ${NGINX_ORIGIN_PRIVATE_KEY_FILE};

    location = /unity {
        return 301 /unity/;
    }

    location = /unity/manifest.json {
        alias /srv/festa/webgl/current/manifest.json;
        default_type application/json;
        add_header Cache-Control "no-cache" always;
    }

    location = /unity/index.html {
        alias /srv/festa/webgl/current/index.html;
        default_type text/html;
        add_header Cache-Control "no-cache" always;
    }

    location ~ ^/unity/Build/([^/]+\.wasm)$ {
        alias /srv/festa/webgl/current/Build/$1;
        default_type application/wasm;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    location ~ ^/unity/Build/([^/]+\.wasm)\.(br|unityweb)$ {
        alias /srv/festa/webgl/current/Build/$1.$2;
        default_type application/wasm;
        add_header Content-Encoding br always;
        add_header Vary Accept-Encoding always;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    location ~ ^/unity/Build/([^/]+\.js)\.(br|unityweb)$ {
        alias /srv/festa/webgl/current/Build/$1.$2;
        default_type application/javascript;
        add_header Content-Encoding br always;
        add_header Vary Accept-Encoding always;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    location ~ ^/unity/Build/([^/]+\.data)\.(br|unityweb)$ {
        alias /srv/festa/webgl/current/Build/$1.$2;
        default_type application/octet-stream;
        add_header Content-Encoding br always;
        add_header Vary Accept-Encoding always;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    location /unity/Build/ {
        alias /srv/festa/webgl/current/Build/;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    location /unity/ {
        alias /srv/festa/webgl/current/;
        add_header Cache-Control "no-cache" always;
    }

    location /ai/v1/ {
        add_header Cache-Control "no-store" always;
        proxy_buffering off;
        proxy_pass http://127.0.0.1:18082;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location / {
        proxy_pass $festa_demo_root_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $festa_demo_connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
        proxy_buffering off;
    }
}
