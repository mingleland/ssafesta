# Spring API base URL. **비워 두는 것이 기본이다** — 비우면 FE 오리진(FE Host Gateway)으로 해석되고
# vite dev 서버의 /api 프록시가 Spring 으로 넘긴다(vite.config.ts, S15P21A604-564). 그래야 React 도
# Unity 도 실제 BE 주소를 모른다. 절대 URL 을 넣으면 게이트웨이를 건너뛰고 그 주소로 직행한다.
# 배포 정본은 컨테이너 런타임 주입 PUBLIC_API_BASE_URL 이다.
# CI/CD re-observation marker (S15P21A604-155, 2026-09-11): runtime values unchanged.
VITE_API_BASE_URL=
# 프록시 대상 재지정(로컬 전용, 기본값이면 생략) — Spring·WebGL 정적 서버 포트를 바꿔 쓸 때만.
# ⚠️ 이 셋은 **이 파일(.env*)이 아니라 shell 환경변수**로 준다 — vite.config.ts 가 process.env 를
# 읽는다(tools/devGateway.mjs). 예: `VITE_PROXY_API_TARGET=http://127.0.0.1:8081 npm run dev`
#   VITE_PROXY_API_TARGET=http://127.0.0.1:8080     /api 와 /oauth2 가 같은 대상으로 간다
#   VITE_PROXY_UNITY_TARGET=http://127.0.0.1:8000
# AI(FastAPI) 프록시는 대상을 줄 때만 등록된다 — 로컬 8000 은 WebGL 정적 서버가 쓰고 있다.
#   VITE_PROXY_AI_TARGET=http://127.0.0.1:8001
# ── 배포 런타임 주입 (컨테이너 entrypoint docker/40-runtime-config.sh) ───────────────────
# 아래 VITE_* 는 로컬/빌드타임 fallback 이고, 배포 정본은 PUBLIC_* 다. 키는 1:1 로 대응하며
# 그 1:1 은 tools/runtimeConfigKeys.test.mjs 가 지킨다 (S15P21A604-567).
#   PUBLIC_API_BASE_URL        → window.__FESTA_CONFIG__.apiBaseUrl      (VITE_API_BASE_URL)
#   PUBLIC_AUTH_BASE_URL       → .authBaseUrl                            (VITE_AUTH_BASE_URL)
#   PUBLIC_AI_API_BASE_URL     → .aiApiBaseUrl                           (VITE_AI_API_BASE_URL)
#   PUBLIC_UNITY_BUILD_BASE    → .unityBuildBase                         (VITE_UNITY_BUILD_BASE)
#   PUBLIC_BOOTH_ASSET_BASE    → .boothAssetBase                         (빌드타임 값 없음)
# 값이 빈 키는 산출물에 넣지 않는다 — "주입했는데 비었다" 와 "주입하지 않았다" 를 구분하기 위해서다.
# ─────────────────────────────────────────────────────────────────────────────────────
# OAuth·게스트 계열 전용 base(S15P21A604-564). 비우면 VITE_API_BASE_URL 판정과 같아진다.
# **로컬은 비워 둔다** — OAuth 시작·refresh·logout·complete 가 전부 FE 게이트웨이(/api·/oauth2)를
# 타고, 인증 쿠키(refresh_token·oauth_handoff·JSESSIONID)는 host-only 라 `localhost` 이면 포트가
# 달라도 실린다. 그래서 5173 이 아닌 포트(5175·5188)에서도 로그인이 그 포트로 돌아온다
# — **단 호스트는 `localhost` 여야 한다.** `http://127.0.0.1:5188` 로 열면 시작 요청이 심은
# JSESSIONID 가 `127.0.0.1` 에 붙고, provider 콜백은 등록값인 `localhost:8080` 으로 돌아와
# 그 쿠키를 싣지 못한다(쿠키 host 비교는 포트만 무관하다). Spring 이
# `authorization_request_not_found` 로 떨어져 로그인이 시작 단계에서 끝난다.
# (S15P21A604-649, GitLab #177). http://localhost:8080 직행을 넣으면 CORS·Origin 검증이 5173 에만
# 묶여 다른 포트에서 refresh 가 UNTRUSTED_ORIGIN 이 된다.
VITE_AUTH_BASE_URL=
# AI(FastAPI) 서버 base URL(로컬/dev fallback) — Spring과 별도 배포다(spec 008). 배포 정본은
# 컨테이너 런타임 주입 PUBLIC_AI_API_BASE_URL 이고 그 값이 있으면 이 값은 무시된다.
# 둘 다 비면 FE 오리진의 /ai/v1 을 부른다(게이트웨이 경로). 인프라가 same-origin 경로 분기로 합칠지
# 별도 호스트로 둘지는 아직 미정이고, 어느 쪽이든 이 accessor 는 그대로다 — 배포 설정만 바뀐다.
VITE_AI_API_BASE_URL=
VITE_GAME_STUDIO_API_ENABLED=false
# 실 BE 없이 개발 — auth·wallet·layout·facade·lease·survey·unity loader 가 메모리 mock 으로 동작 (*.select.ts)
VITE_USE_MOCK=false
# Unity WebGL 빌드가 서빙되는 base URL(로컬/dev fallback) — `${BASE}/manifest.json` 을 읽고 manifest 의 상대경로를
# 이 base 기준으로 푼다(unity/host/resolver.ts, 키 4종 #60). 배포 정본은 컨테이너 런타임 주입 PUBLIC_UNITY_BUILD_BASE
# (docker/40-runtime-config.sh → window.__FESTA_CONFIG__.unityBuildBase)이고 그 값이 있으면 이 값은 무시된다(#127).
# 둘 다 비면 실 빌드 로드는 이름을 말하며 실패한다 — mock 로더(VITE_USE_MOCK=true)는 이 값이 필요 없다.
VITE_UNITY_BUILD_BASE=
# World 하단 개발용 상호작용 트리거(DEV_ONLY) — Unity 송신부 없이 Overlay dispatcher 하류를
# 검증할 때만 true. 제품 HUD 가 아니며 dev 빌드에서만 동작한다(hud-decisions: 기능 Launcher 금지).
VITE_DEV_INTERACTION_BAR=false
# 개발자 전용 진입(S15P21A604-467) — 로그인 화면에 "개발자로 입장" 을 띄우고 좌상단에 DEV 배지를 단다.
# 회원 세션을 그 자리에서 만들어 회원 전용 화면을 열어 볼 때 쓴다. 제품 로그인 버튼은 빌려 쓰지 않는다.
# import.meta.env.DEV 와 AND 로 묶여 있어 **프로덕션 빌드에서는 이 값이 true 여도 켜지지 않고**
# 관련 코드가 번들에서 사라진다(실측: 산출물 문자열 0건).
VITE_DEV_ENTRY=false
# Booth Studio 2.5D 캔버스 렌더러 선택(S15P21A604-470, D-05 Spike) — 기본은 R3F 다.
# 'false' 로 두면 이전 SVG 아이소메트릭 렌더러(TemporaryIsoRenderer)로 돌아간다. A/B 비교용이자
# Spike 가 FAIL 로 끝났을 때의 복귀 경로다. 값과 무관하게 three 는 lazy chunk 에만 들어간다.
VITE_R3F_CANVAS=true
# Booth Studio 2.5D 시각 검증 전용(S15P21A604-480) — 켜면 캔버스가 frameloop='never' + 타이머로
# 프레임을 민다. requestAnimationFrame 이 멈추는 환경(숨겨진 브라우저 pane)에서 3D 가 마지막
# 프레임에 얼어붙는 것을 피하려는 것이고, **제품 동작이 아니다**. 기본·프로덕션은 demand 다.
VITE_R3F_VISUAL_ACCEPTANCE=false
