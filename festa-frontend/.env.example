VITE_API_BASE_URL=
VITE_GAME_STUDIO_API_ENABLED=false
# 실 BE 없이 개발 — auth·wallet·layout·facade·lease·unity loader 가 메모리 mock 으로 동작 (*.select.ts)
VITE_USE_MOCK=false
# Unity WebGL 빌드가 서빙되는 base URL(로컬/dev fallback) — `${BASE}/manifest.json` 을 읽고 manifest 의 상대경로를
# 이 base 기준으로 푼다(unity/host/resolver.ts, 키 4종 #60). 배포 정본은 컨테이너 런타임 주입 PUBLIC_UNITY_BUILD_BASE
# (docker/40-runtime-config.sh → window.__FESTA_CONFIG__.unityBuildBase)이고 그 값이 있으면 이 값은 무시된다(#127).
# 둘 다 비면 실 빌드 로드는 이름을 말하며 실패한다 — mock 로더(VITE_USE_MOCK=true)는 이 값이 필요 없다.
VITE_UNITY_BUILD_BASE=
# World 하단 개발용 상호작용 트리거(DEV_ONLY) — Unity 송신부 없이 Overlay dispatcher 하류를
# 검증할 때만 true. 제품 HUD 가 아니며 dev 빌드에서만 동작한다(hud-decisions: 기능 Launcher 금지).
VITE_DEV_INTERACTION_BAR=false
# 개발자 전용 진입(S15P21A604-467) — 로그인 화면에 "개발자로 입장" 을 띄우고 좌상단에 DEV 배지를 단다.
# 회원 세션을 그 자리에서 만들어 회원 전용 화면을 열어 볼 때 쓴다. 제품 로그인 버튼은 빌려 쓰지 않는다.
# import.meta.env.DEV 와 AND 로 묶여 있어 **프로덕션 빌드에서는 이 값이 true 여도 켜지지 않고**
# 관련 코드가 번들에서 사라진다(실측: 산출물 문자열 0건).
VITE_DEV_ENTRY=false
# Booth Studio 2.5D 캔버스 렌더러 선택(S15P21A604-470, D-05 Spike) — 기본은 R3F 다.
# 'false' 로 두면 이전 SVG 아이소메트릭 렌더러(TemporaryIsoRenderer)로 돌아간다. A/B 비교용이자
# Spike 가 FAIL 로 끝났을 때의 복귀 경로다. 값과 무관하게 three 는 lazy chunk 에만 들어간다.
VITE_R3F_CANVAS=true
