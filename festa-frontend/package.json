{
  "name": "festa-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "assets:build": "node tools/assets/build-booth-assets.mjs && node tools/assets/compile-runtime-assets.mjs",
    "assets:verify": "node tools/assets/verify-runtime-assets.mjs",
    "dev": "npm run assets:build && vite",
    "build": "npm run assets:build && tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^30.0.1",
    "meshoptimizer": "^1.2.0",
    "oxlint": "^1.75.0",
    "sharp": "^0.35.4",
    "three": "^0.180.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.11"
  }
}
