#!/usr/bin/env bash
set -euo pipefail; source "$(dirname "$0")/lib.sh"
test_project() { case "${CI_COMPONENT}" in ai) python -m pytest --junitxml="${CI_ARTIFACT_DIR}/tests.xml";; back) if [[ -x ./gradlew ]]; then ./gradlew test; else ./mvnw test; fi;; front) npm ci && npm test -- --run;; game) bash festa-unity/ci/test;; esac; }
ci_run test TEST_FAILED ci_dispatch_or test test_project
