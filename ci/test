#!/usr/bin/env bash
set -euo pipefail; source "$(dirname "$0")/lib.sh"
test_project() {
  local component_dir
  component_dir="$(ci_component_dir)"
  case "${CI_COMPONENT}" in
    ai)
      (cd "${component_dir}" \
        && python -m venv .venv \
        && .venv/bin/python -m pip install --disable-pip-version-check --no-input '.[test]' \
        && .venv/bin/python -m pytest tests/unit tests/contract --junitxml="${CI_ARTIFACT_DIR}/tests.xml") ;;
    back) (
      cd "${component_dir}"
      export TESTCONTAINERS_RYUK_DISABLED=true
      # Test-only values prevent inherited deployment secrets from affecting CI.
      export JWT_SECRET='YWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYQ=='
      export CONNECTION_TOKEN_SECRET='YmJiYmJiYmJiYmJiYmJiYmJiYmJiYmJiYmJiYmJiYmJiYmJiYmJiYmJiYmJiYmJiYmJiYmJiYmJiYmJiYmJiYg=='
      export GOOGLE_CLIENT_ID=test-google-client-id GOOGLE_CLIENT_SECRET=test-google-client-secret
      export GOOGLE_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google
      export KAKAO_REST_API_KEY=test-kakao-rest-api-key KAKAO_CLIENT_SECRET=test-kakao-client-secret
      export KAKAO_REDIRECT_URI=http://localhost:8080/login/oauth2/code/kakao
      # 실패해도 리포트를 꺼내야 한다. set -e 아래에서 그냥 두면 여기서 빠져나가고,
      # job 로그는 4MB에서 잘리므로 실패한 테스트 이름이 어디에도 남지 않는다 (GitLab #190).
      status=0
      if [[ -x ./gradlew ]]; then ./gradlew test || status=$?; else ./mvnw test || status=$?; fi
      cp target/surefire-reports/TEST-*.xml "${CI_ARTIFACT_DIR}/" 2>/dev/null || true
      cp build/test-results/test/TEST-*.xml "${CI_ARTIFACT_DIR}/" 2>/dev/null || true
      exit "${status}"
    ) ;;
    # S15P21A604-696 — Game Studio 테스트(src/game-studio/**, 전체 스위트의 28~38%)가 QA
    # 사이클마다 늘어나며 front-test 실행 시간을 지연시킨다는 지적(#180)에 따라, 원격 CI에서만
    # 제외한다. 로컬 npm test(package.json)는 이 exclude를 안 거치므로 그대로 전체 실행된다.
    front) (cd "${component_dir}" && npm ci && npm test -- --run --exclude 'src/game-studio/**') ;;
    game) bash festa-unity/ci/test ;;
  esac
}
ci_run test TEST_FAILED ci_dispatch_or test test_project
