#!/usr/bin/env bash
set -euo pipefail; source "$(dirname "$0")/lib.sh"
: "${DEPLOY_TARGET:?}" "${RELEASE_ID:?}" "${RELEASE_MANIFEST_PATH:?}"
verify_project() { if [[ "${CI_COMPONENT}" == game && -f "${ci_root}/festa-unity/ci/verify" ]]; then bash "${ci_root}/festa-unity/ci/verify"; else bash "${ci_root}/infra/deploy/scripts/verify-component.sh"; fi; }
ci_run verify VERIFY_NON_AI ci_dispatch_or verify verify_project
