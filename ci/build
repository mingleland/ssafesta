#!/usr/bin/env bash
set -euo pipefail; source "$(dirname "$0")/lib.sh"
build_project() {
  local component_dir
  component_dir="$(ci_component_dir)"
  case "${CI_COMPONENT}" in
    ai) (cd "${component_dir}" && python -m compileall -q -x '\.venv' .) ;;
    back) (cd "${component_dir}" && if [[ -x ./gradlew ]]; then ./gradlew clean build -x test; else ./mvnw clean package -DskipTests; fi) ;;
    front) (
      cd "${component_dir}"
      npm ci
      npm run assets:verify
      npm run build
      # Jenkins 는 develop workspace 를 재사용하고 checkout 은 artifacts/ 를 지우지 않는다.
      # 이전 run 의 front-dist 가 남아 있으면 그대로 비우고 이번 build 산출물로 채운다.
      rm -rf -- "${CI_ARTIFACT_DIR}/front-dist"
      mkdir -p "${CI_ARTIFACT_DIR}/front-dist"
      cp -a dist/. "${CI_ARTIFACT_DIR}/front-dist/"
    ) ;;
    # WebGL 클라이언트와 Linux Dedicated Server 를 같은 checkout 에서 연달아 만든다 — 한 source 의 client/server 가 한 release set 이다 (Batch 2).
    # 전후 자원 스냅샷은 Runner/host 용량 판단의 유일한 근거다.
    game)
      local evidence="${CI_ARTIFACT_DIR}/resource-evidence.json"
      bash infra/jenkins/scripts/collect-build-resource-evidence.sh start "${evidence}"
      bash festa-unity/ci/build --target webgl
      bash festa-unity/ci/build --target linux-server
      bash infra/jenkins/scripts/collect-build-resource-evidence.sh finish "${evidence}" festa-unity/Builds/linux-server/festa-unity.x86_64
      ;;
  esac
}
ci_run build BUILD_FAILED build_project
