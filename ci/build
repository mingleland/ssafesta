#!/usr/bin/env bash
set -euo pipefail; source "$(dirname "$0")/lib.sh"
build_project() {
  local component_dir
  component_dir="$(ci_component_dir)"
  case "${CI_COMPONENT}" in
    ai) (cd "${component_dir}" && python -m compileall -q -x '\.venv' .) ;;
    back) (
      cd "${component_dir}"
      reuse_compiled=false
      stamp_file="target/.build-source-stamp"
      if [[ -f "${stamp_file}" ]]; then
        IFS=$'\t' read -r stamp_sha stamp_run_id < "${stamp_file}" || true
        if [[ "${stamp_sha:-}" == "${CI_COMMIT_SHA:-}" && "${stamp_run_id:-}" == "${CI_RUN_ID:-}" && -d "target/classes" ]]; then
          reuse_compiled=true
        fi
      fi
      if [[ "${reuse_compiled}" == true ]]; then
        echo "Reusing classes compiled during test phase in the same pipeline run..."
        if [[ -x ./gradlew ]]; then ./gradlew build -x test; else ./mvnw package -DskipTests; fi
      else
        echo "Stale or missing build stamp — running clean package..."
        if [[ -x ./gradlew ]]; then ./gradlew clean build -x test; else ./mvnw clean package -DskipTests; fi
      fi
      printf '%s\t%s\n' "${CI_COMMIT_SHA:-}" "${CI_RUN_ID:-}" > "${stamp_file}"
    ) ;;
    front) (
      cd "${component_dir}"
      if [[ ! -d node_modules || package-lock.json -nt node_modules ]]; then npm ci; fi
      npm run assets:verify
      npm run build
      # Jenkins 는 develop workspace 를 재사용하고 checkout 은 artifacts/ 를 지우지 않는다.
      # 이전 run 의 front-dist 가 남아 있으면 그대로 비우고 이번 build 산출물로 채운다.
      rm -rf -- "${CI_ARTIFACT_DIR}/front-dist"
      mkdir -p "${CI_ARTIFACT_DIR}/front-dist"
      cp -a dist/. "${CI_ARTIFACT_DIR}/front-dist/"
    ) ;;
    # Unity 담당자 로컬 producer 경로 (Jenkins 는 Unity Editor 를 돌리지 않는다 — Batch 2 Consumer-only).
    # WebGL 클라이언트와 Linux Dedicated Server 를 같은 checkout 에서 연달아 만들어 한 release set 을 이룬다.
    game) bash festa-unity/ci/build --target webgl && bash festa-unity/ci/build --target linux-server ;;
  esac
}
ci_run build BUILD_FAILED build_project
