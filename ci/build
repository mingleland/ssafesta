#!/usr/bin/env bash
set -euo pipefail; source "$(dirname "$0")/lib.sh"
build_project() {
  local component_dir
  component_dir="$(ci_component_dir)"
  case "${CI_COMPONENT}" in
    ai) (cd "${component_dir}" && python -m compileall -q .) ;;
    back) (cd "${component_dir}" && if [[ -x ./gradlew ]]; then ./gradlew clean build -x test; else ./mvnw package -DskipTests; fi) ;;
    front) (
      cd "${component_dir}"
      npm ci
      npm run assets:verify
      npm run build
      [[ ! -e "${CI_ARTIFACT_DIR}/front-dist" ]] || { echo 'front artifact already exists' >&2; exit 65; }
      mkdir -p "${CI_ARTIFACT_DIR}/front-dist"
      cp -a dist/. "${CI_ARTIFACT_DIR}/front-dist/"
    ) ;;
    game) bash festa-unity/ci/build --target linux-server ;;
  esac
}
ci_run build BUILD_FAILED ci_dispatch_or build build_project --target linux-server
