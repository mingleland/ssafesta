# backend/.env — 로컬 실행용. 이 파일을 `.env` 로 복사해 값을 채운다.
# `.env` 는 추적하지 않고 이 예시만 추적한다. 여기에 실제 값을 적지 않는다 (헌법 15조).
#
# 테스트(`./mvnw test`)에는 이 파일이 필요 없다 — src/test/resources 가 값을 공급한다.
# 아래 값이 필요한 것은 애플리케이션을 실제로 띄울 때다.

# ── 로컬 인프라 (compose.yaml 이 같이 읽는다) ──────────────────────────────
POSTGRES_DB=ssafesta
POSTGRES_USER=ssafesta
# 직접 정한다. compose 와 앱이 같은 값을 봐야 한다.
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
REDIS_PORT=6379

# ── Spring 애플리케이션 Secret ─────────────────────────────────────────────
# 기본값이 없다 — 없으면 기동이 실패한다. 생성 예: openssl rand -base64 48
# JWT_SECRET 은 base64 여야 한다. 평문을 넣으면 "Illegal base64 character" 로 죽는다.
JWT_SECRET=
# Access Token 키와 분리된 게임 서버 전용 서명 키 (헌법 14조).
CONNECTION_TOKEN_SECRET=

# ── OAuth (spec 001) ───────────────────────────────────────────────────────
# 리디렉트 URI 는 각 제공자 콘솔에 등록한 값과 정확히 같아야 한다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=
SSAFY_CLIENT_ID=
SSAFY_CLIENT_SECRET=
SSAFY_REDIRECT_URI=

# ── 내부 API 서비스 토큰 (GitLab #102) ─────────────────────────────────────
# FastAPI → Spring 방향. 콤마 구분 1~2개, 앞뒤 공백·빈 항목·중복은 기동 실패다.
# 송신은 첫 값, 검증은 목록 전체. 회전: [old] → [old,new] → [new,old] → [new]
# FastAPI 쪽 festa-ai/.env 의 같은 이름 값과 반드시 일치해야 한다.
INTERNAL_AI_TO_SPRING_TOKENS=
