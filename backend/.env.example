# backend/.env — 로컬 실행용. 이 파일을 `.env` 로 복사해 값을 채운다.
# `.env` 는 추적하지 않고 이 예시만 추적한다. 여기에 실제 값을 적지 않는다 (헌법 15조).
#
# 테스트(`./mvnw test`)에는 이 파일이 필요 없다 — src/test/resources 가 값을 공급한다.
# 아래 값이 필요한 것은 애플리케이션을 실제로 띄울 때다.

# ── 로컬 인프라 (compose.yaml 이 같이 읽는다) ──────────────────────────────
POSTGRES_DB=ssafesta
POSTGRES_USER=ssafesta
# 직접 정한다. compose 와 앱이 같은 값을 봐야 한다.
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
REDIS_PORT=6379

# ── Spring 애플리케이션 Secret ─────────────────────────────────────────────
# 기본값이 없다 — 없으면 기동이 실패한다. 생성 예: openssl rand -base64 48
# JWT_SECRET 은 base64 여야 한다. 평문을 넣으면 "Illegal base64 character" 로 죽는다.
JWT_SECRET=
# Access Token 키와 분리된 게임 서버 전용 서명 키 (헌법 14조).
CONNECTION_TOKEN_SECRET=

# ── OAuth (spec 001) ───────────────────────────────────────────────────────
# 리디렉트 URI 는 각 제공자 콘솔에 등록한 값과 정확히 같아야 한다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=

# ── 내부 API 서비스 토큰 (GitLab #102) ─────────────────────────────────────
# FastAPI → Spring 방향. 콤마 구분 1~2개, 앞뒤 공백·빈 항목·중복은 기동 실패다.
# 송신은 첫 값, 검증은 목록 전체. 회전: [old] → [old,new] → [new,old] → [new]
# FastAPI 쪽 festa-ai/.env 의 같은 이름 값과 반드시 일치해야 한다.
INTERNAL_AI_TO_SPRING_TOKENS=

# ── 문서 원본 저장소 (spec 007 C-07) ───────────────────────────────────────
# Cloudflare R2 (S3 호환). credential 은 Infra 소유이고, 문서 bucket 과 서버가 만드는
# prefix 로 scope 를 좁힌 것을 받는다 (GitLab #84). 기본값이 없어 없으면 기동이 실패한다.
# endpoint 예시: https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# MinIO fallback (spec 007 C-10). 평소에는 비워 둔다 — 네 값이 전부 비면 미구성으로 보고
# provider 목록에서 빠진다. 전환할 때 네 값을 채우고 AI_STORAGE_ACTIVE_WRITE_PROVIDER 를
# MINIO_LOCAL 로 바꾼다. 일부만 채우면 오타로 보고 기동이 실패한다.
MINIO_ENDPOINT=
MINIO_BUCKET=
MINIO_ACCESS_KEY_ID=
MINIO_SECRET_ACCESS_KEY=

# 신규 업로드가 갈 provider (FR-030). 기존 문서의 읽기·삭제는 문서 행의 storage_provider 를
# 따르므로 이 값을 바꿔도 옛 파일은 옛 저장소에서 읽는다. R2 | MINIO_LOCAL
AI_STORAGE_ACTIVE_WRITE_PROVIDER=R2

# 업로드 허용 게이트 (spec 007 FR-031, #100 2026-09-01 확정). 기본값이 없다 — 빠지면 기동이
# 실패한다. 안전 장치가 오타로 열리지 않게 한 것이다.
# 운영자가 Usage Guard 와 저장소 전환 상태를 읽고 아래 한 칸으로 옮겨 적는다.
#   OPEN           정상·경고, LOCAL_ACTIVE 검증 완료 → 발급
#   QUOTA_BLOCKED  사용량 90% 초과 → 507 (재시도해도 풀리지 않는다)
#   UNAVAILABLE    stale 지표·R2 장애·FALLBACK_VALIDATING·R2_RECONCILING → 503 (재시도 가능)
AI_STORAGE_UPLOAD_GATE=OPEN
