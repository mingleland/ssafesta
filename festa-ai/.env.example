# Runtime
APP_ENV=local
LOG_LEVEL=INFO

# Worker heartbeat — lease·재시도 예산은 Spring이 소유한다 (S15P21A604-449).
JOB_HEARTBEAT_SECONDS=30
DOCUMENT_WORKER_MAX_CONCURRENCY=1
DOCUMENT_WORKER_SHUTDOWN_GRACE_SECONDS=30

# 문서 처리 결과 전달(S15P21A604-124) — chunk-batches/finalize/heartbeat/failed 공통 timeout.
SPRING_DOCUMENT_RESULT_TIMEOUT_SECONDS=5.0
# Embedding Provider 호출 1회에 담을 최대 chunk 개수.
EMBEDDING_BATCH_SIZE=96

# Document limits and chunk tuning
DOCUMENT_MAX_BYTES=20971520
AGENT_DOCUMENT_MAX_COUNT=10
AGENT_DOCUMENT_MAX_TOTAL_BYTES=104857600
CHUNK_SIZE=900
CHUNK_OVERLAP=180

# Embedding provider
EMBEDDING_DIMENSION=1536
EMBEDDING_MODEL_ID=text-embedding-3-large
EMBEDDING_PROVIDER=mock
EMBEDDING_API_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com
EMBEDDING_API_PATH=/v1/embeddings
EMBEDDING_API_KEY=

# RAG retrieval and generation (S15P21A604-370..372 spike defaults)
RETRIEVAL_TOP_K=10
RAG_CONTEXT_TOP_N=5
RAG_INPUT_TOKEN_BUDGET=8000
RAG_TOKENIZER_ENCODING=cl100k_base
LLM_MODEL_ID=gpt-4.1-mini
LLM_TEMPERATURE=0.0
LLM_PROVIDER=mock
LLM_API_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com
LLM_API_PATH=/v1/chat/completions
LLM_CONNECT_TIMEOUT_SECONDS=10
LLM_READ_TIMEOUT_SECONDS=15
# GMS 공통 키는 배포 Secret으로만 주입한다. 실제 환경은 두 Provider를 gms로 전환한다.
GMS_API_KEY=

# Conversation (spec 008)
JWT_SECRET=
REDIS_URL=
CONVERSATION_TTL_SECONDS=1800
SPRING_BOOTH_ACCESS_TIMEOUT_SECONDS=1.0
# 질문당 1회, 검색 전에 호출. 캐시·재시도 없음 (S15P21A604-507).
SPRING_AGENT_CONFIG_TIMEOUT_SECONDS=1.0
SPRING_CHUNK_SEARCH_TIMEOUT_SECONDS=3.5
# 응답 timeout (spec 008 FR-007) — 첫 token까지 15초, 전체 응답 60초.
LLM_TTFT_TIMEOUT_SECONDS=15.0
LLM_TOTAL_TIMEOUT_SECONDS=60.0
# 동시 스트림 한도·FIFO 대기열 (spec 008 FR-019/020, S15P21A604-142).
RATE_LIMIT_USER_CONCURRENCY=1
RATE_LIMIT_USER_QUESTION_LIMIT=5
RATE_LIMIT_USER_QUESTION_WINDOW_SECONDS=60.0
RATE_LIMIT_AGENT_CONCURRENCY=5
RATE_LIMIT_GLOBAL_CONCURRENCY=20
RATE_LIMIT_QUEUE_CAPACITY=30
RATE_LIMIT_QUEUE_WAIT_SECONDS=10.0
# LLM_TOTAL_TIMEOUT_SECONDS보다 반드시 커야 한다.
RATE_LIMIT_ACTIVE_LEASE_TTL_SECONDS=90.0

# Spring internal callback
SPRING_INTERNAL_BASE_URL=
INTERNAL_SPRING_TO_AI_TOKENS=
INTERNAL_AI_TO_SPRING_TOKENS=

# R2 object storage (primary)
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto

# MinIO object storage (operator-approved manual fallback only, never auto-selected)
MINIO_ENDPOINT=
MINIO_BUCKET=
MINIO_ACCESS_KEY_ID=
MINIO_SECRET_ACCESS_KEY=
