# Runtime
APP_ENV=local
LOG_LEVEL=INFO

# Database secrets are injected by deployment or CI secret storage.
DATABASE_URL=

# Migration-only connection (separate migration role; alembic's migrations/env.py
# reads this directly via os.getenv, independent of app.core.config.Settings).
MIGRATION_DATABASE_URL=

# Worker lease and recovery
JOB_HEARTBEAT_SECONDS=30
JOB_LEASE_SECONDS=90
JOB_SWEEPER_SECONDS=60
JOB_MAX_RETRIES=3
JOB_RETRY_BACKOFF_SECONDS=60,300,900

# Document limits and chunk tuning
DOCUMENT_MAX_BYTES=20971520
AGENT_DOCUMENT_MAX_COUNT=10
AGENT_DOCUMENT_MAX_TOTAL_BYTES=104857600
CHUNK_SIZE=
CHUNK_OVERLAP=

# Embedding provider
EMBEDDING_DIMENSION=1536
EMBEDDING_MODEL_ID=
EMBEDDING_PROVIDER=
EMBEDDING_API_BASE_URL=
EMBEDDING_API_KEY=

# Spring internal callback
SPRING_INTERNAL_BASE_URL=
INTERNAL_SPRING_TO_AI_TOKENS=
INTERNAL_AI_TO_SPRING_TOKENS=

# R2 object storage (primary)
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# MinIO object storage (operator-approved manual fallback only, never auto-selected)
MINIO_ENDPOINT=
MINIO_BUCKET=
MINIO_ACCESS_KEY_ID=
MINIO_SECRET_ACCESS_KEY=
