#!/usr/bin/env bash
# 게임 파트 CI 패키징 어댑터 — 같은 checkout 의 WebGL(zip) 과 Linux Dedicated Server(docker image) 를 한 release set 으로 묶는다 (Batch 2).
#
# WebGL zip 은 결정적으로 만든다(정렬·1980-01-01·0644·DEFLATE 6·디렉터리 엔트리 없음): 같은 build output 이면
# 같은 bytes/SHA256 이다. zip 안의 ci-provenance.json 은 source 에서만 결정되는 값만 담는다 — Jenkins build 번호처럼
# 실행마다 달라지는 값은 Registry 의 .json sidecar 로 간다(publish-webgl-release.sh).
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "${script_dir}/../.." && pwd)"
project_dir="$(cd "${script_dir}/.." && pwd)"
: "${CI_COMMIT_SHA:?}" "${CI_ARTIFACT_DIR:?}"

webgl_dir="${project_dir}/Builds/webgl"
[[ -f "${webgl_dir}/manifest.json" ]] || { echo "WebGL build output 이 없다: ${webgl_dir}/manifest.json" >&2; exit 66; }
release_id="${CI_COMMIT_SHA:0:8}"
archive="${CI_ARTIFACT_DIR}/festa-webgl-release-${release_id}.zip"
mkdir -p "${CI_ARTIFACT_DIR}"

# LFS pointer 가 남아 있으면 그 build 는 소스 전체를 담지 못한 것이다.
lfs_resolved=true
if command -v git-lfs >/dev/null 2>&1 && git -C "${repo_root}" lfs ls-files 2>/dev/null | grep -q ' - '; then lfs_resolved=false; fi
[[ "${lfs_resolved}" == true ]] || { echo 'LFS_POINTER_UNRESOLVED: build output 에 LFS pointer 파일이 섞여 있다' >&2; exit 78; }

"${PYTHON_BIN:-python3}" - "${webgl_dir}" "${archive}" "${CI_COMMIT_SHA}" "${CI_BRANCH:-develop}" <<'PY'
import json, os, pathlib, sys, zipfile
source_dir, archive_path, commit, branch = sys.argv[1:5]
root = pathlib.Path(source_dir)
manifest = json.loads((root / 'manifest.json').read_text(encoding='utf-8'))
if manifest.get('sourceCommit') != commit: raise SystemExit(f'WebGL manifest sourceCommit {manifest.get("sourceCommit")!r} != checkout {commit}')
if manifest.get('dirty') is not False: raise SystemExit('WebGL manifest dirty != false; dirty builds are not packaged')
provenance = json.dumps({
    'schemaVersion': '1.0.0', 'component': 'webgl', 'sourceCommit': commit, 'sourceBranch': branch,
    'unityVersion': manifest.get('unityVersion'), 'buildProfile': manifest.get('buildProfile'), 'lfsResolved': True,
}, indent=2, sort_keys=True) + '\n'
entries = sorted(p for p in root.rglob('*') if p.is_file())
tmp = pathlib.Path(archive_path + '.tmp')
with zipfile.ZipFile(tmp, 'w') as archive:
    def add(name, data):
        info = zipfile.ZipInfo(name, date_time=(1980, 1, 1, 0, 0, 0))
        info.external_attr = (0o100644 << 16)
        info.compress_type = zipfile.ZIP_DEFLATED
        archive.writestr(info, data, compress_type=zipfile.ZIP_DEFLATED, compresslevel=6)
    names = {p.relative_to(root).as_posix() for p in entries}
    if 'ci-provenance.json' in names: raise SystemExit('build output already contains ci-provenance.json')
    for path in sorted(list(entries) + [None], key=lambda p: 'ci-provenance.json' if p is None else p.relative_to(root).as_posix()):
        if path is None: add('ci-provenance.json', provenance.encode('utf-8'))
        else: add(path.relative_to(root).as_posix(), path.read_bytes())
os.replace(tmp, archive_path)
PY
bash "${repo_root}/infra/jenkins/scripts/validate-webgl-archive.sh" "${archive}" --source-commit "${CI_COMMIT_SHA}" --branch "${CI_BRANCH:-develop}"
archive_sha="$(sha256sum "${archive}" | awk '{print $1}')"
printf '%s  %s\n' "${archive_sha}" "$(basename "${archive}")" >"${archive}.sha256"
ARCHIVE="${archive}" ARCHIVE_SHA="${archive_sha}" RELEASE_ID="${release_id}" COMMIT="${CI_COMMIT_SHA}" "${PYTHON_BIN:-python3}" - "${CI_ARTIFACT_DIR}/webgl-metadata.json" <<'PY'
import json, os, pathlib, sys
pathlib.Path(sys.argv[1]).write_text(json.dumps({
    'schemaVersion': '1.0.0', 'component': 'webgl', 'releaseId': os.environ['RELEASE_ID'], 'sourceCommit': os.environ['COMMIT'],
    'artifactSha256': os.environ['ARCHIVE_SHA'], 'archivePath': os.environ['ARCHIVE'], 'archiveName': os.path.basename(os.environ['ARCHIVE']),
}, indent=2) + '\n', encoding='utf-8')
PY
echo "PACKAGED_WEBGL: ${release_id} ${archive_sha}"

IMAGE_NAME="${IMAGE_NAME:-festa-game}" \
DOCKERFILE="${script_dir}/../Docker/Dockerfile" \
BUILD_CONTEXT="${script_dir}/../Builds/linux-server" \
bash "${repo_root}/infra/deploy/scripts/package-local-image.sh"
