#!/usr/bin/env bash
# 게임 파트 CI 빌드 어댑터.
#
# ci/README.md 가 "Game: festa-unity/ci/ 의 Unity 전용 adapter" 라고 약속하고
# infra/jenkins/pipelines/unity.groovy 와 루트 ci/build 가 이 파일을 호출하는데
# 그동안 파일 자체가 없었다 — 게임 파트 CI 는 시작하자마자 실패했다.
#
# 사용: festa-unity/ci/build --target webgl|linux-server|all
set -euo pipefail

target="all"
while [[ $# -gt 0 ]]; do
  case "$1" in
    --target)
      if [[ $# -lt 2 || -z "${2:-}" ]]; then echo "--target 에 값이 없다" >&2; exit 64; fi
      target="$2"; shift 2 ;;
    *) echo "알 수 없는 인자: $1" >&2; exit 64 ;;
  esac
done

case "${target}" in
  webgl|linux-server|all) ;;
  *) echo "잘못된 타깃: ${target} (webgl|linux-server|all)" >&2; exit 64 ;;
esac

project_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
unity_version="$(sed -n 's/^m_EditorVersion: //p' "${project_dir}/ProjectSettings/ProjectVersion.txt")"
: "${UNITY_EXECUTABLE:=/opt/unity/editors/${unity_version}/Editor/Unity}"

if [[ ! -x "${UNITY_EXECUTABLE}" ]]; then
  echo "Unity 실행 파일을 찾을 수 없다: ${UNITY_EXECUTABLE}" >&2
  echo "UNITY_EXECUTABLE 로 경로를 넘겨라 (프로젝트 버전 ${unity_version})." >&2
  exit 69
fi

log_file="${CI_ARTIFACT_DIR:-${project_dir}/Builds}/unity-build-${target}.log"
mkdir -p "$(dirname "${log_file}")"

echo "Unity ${unity_version} 배치 빌드 — 타깃 ${target}"
echo "로그: ${log_file}"

# -quit 은 넣지 않는다. CiBuild 가 EditorApplication.Exit 로 종료 코드를 직접 정한다.
set +e
"${UNITY_EXECUTABLE}" \
  -batchmode -nographics \
  -projectPath "${project_dir}" \
  -executeMethod Festa.EditorTools.CiBuild.Build \
  -festaTarget "${target}" \
  -logFile "${log_file}"
status=$?
set -e

if [[ ${status} -ne 0 ]]; then
  echo "Unity 빌드 실패 (종료 코드 ${status}). 로그 마지막 40줄:" >&2
  tail -n 40 "${log_file}" >&2 || true
  exit "${status}"
fi

echo "빌드 완료 — 타깃 ${target}"
