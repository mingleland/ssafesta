#!/usr/bin/env bash
# Unity 배치 빌드(45분)를 시작하기 전에 2초짜리 라이선스 검사로 먼저 멈춘다.
#
# 2026-09-19 agent recreate 뒤 #498/#504/#505 가 전부 exit 198(No valid Unity Editor license)로 죽었다.
# 원인은 Unity Personal entitlement 가 이전 컨테이너 hostname/machine id 에 바인딩된 채 남아 있던 것
# (Legacy MachineBinding validation failed). Licensing Client 는 프로젝트 import 없이 곧바로 답하므로
# 여기서 확인하면 실패가 Unity 실행 전에 드러난다.
#
# 종료 코드: 0 = entitlement 확인, 69 = Licensing Client 없음, 79 = UNITY_LICENSE_INVALID
set -euo pipefail

project_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
unity_version="$(sed -n 's/^m_EditorVersion: //p' "${project_dir}/ProjectSettings/ProjectVersion.txt")"
editor_root="${UNITY_EDITOR_ROOT:-/opt/unity}"
client="${UNITY_LICENSING_CLIENT:-${editor_root}/editors/${unity_version}/Editor/Data/Resources/Licensing/Client/Unity.Licensing.Client}"

if [[ ! -x "${client}" ]]; then
  echo "Unity Licensing Client 를 찾을 수 없다: ${client}" >&2
  exit 69
fi

entitlements="$(timeout "${UNITY_LICENSE_TIMEOUT_SECONDS:-60}" "${client}" --showEntitlements 2>&1 || true)"
if [[ -z "${entitlements}" || "${entitlements}" == *'No licenses were found'* ]]; then
  echo 'UNITY_LICENSE_INVALID: 이 에이전트 identity 에 부여된 Unity entitlement 가 없다.' >&2
  echo "showEntitlements: ${entitlements:-<empty>}" >&2
  # 어떤 identity 로 검사했는지 남긴다 — 라이선스 파일이 아니라 컨테이너 hostname/machine binding 이 바뀐 것이 보통이다.
  timeout 30 "${client}" --showContext 2>&1 | grep -i -E 'hostname|machine|binding' >&2 || true
  echo '복구: infra/unity-server/runbooks/unity-build.md §라이선스 재활성화' >&2
  exit 79
fi
echo "Unity entitlement 확인 (${unity_version})"
printf '%s\n' "${entitlements}"
